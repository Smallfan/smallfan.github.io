<%
  var searchConfig = theme.search || {};
  var searchPath = searchConfig.path || '/search/';
  var searchIndex = searchConfig.index || '/search.json';
%>
<section class="search-page" data-search-page data-search-index="<%- url_for(searchIndex) %>" data-site-title="<%= config.title %>">
  <header class="search-page-header">
    <h1 class="search-page-title" data-search-heading>Search</h1>
    <p class="search-page-description">Search article titles, categories, tags, and content.</p>
  </header>

  <form class="search-page-form" role="search" method="get" action="<%- url_for(searchPath) %>">
    <label class="screen-reader-text" for="search-page-field">Search terms</label>
    <input id="search-page-field" class="search-page-field" type="search" name="q" placeholder="Enter keywords" autocomplete="off" required data-search-input>
    <button class="search-page-submit" type="submit">Search</button>
  </form>

  <p class="search-status" role="status" aria-live="polite" data-search-status>Enter keywords to begin.</p>
  <div class="search-results" data-search-results></div>
  <noscript><p class="search-empty">Search requires JavaScript.</p></noscript>
</section>

<script src="<%- url_for('/js/search.js') %>" defer></script>
