<%
  var searchConfig = theme.search || {};
  var searchPath = searchConfig.path || '/search/';
  var searchIndex = searchConfig.index || '/search.json';
%>
<section class="search-page" data-search-page data-search-index="<%- url_for(searchIndex) %>" data-site-title="<%= config.title %>">
  <header class="search-page-header">
    <h1 class="search-page-title" data-search-heading>搜索</h1>
    <p class="search-page-description">搜索本站文章的标题、分类、标签与正文内容。</p>
  </header>

  <form class="search-page-form" role="search" method="get" action="<%- url_for(searchPath) %>">
    <label class="screen-reader-text" for="search-page-field">搜索关键词</label>
    <input id="search-page-field" class="search-page-field" type="search" name="q" placeholder="输入关键词" autocomplete="off" required data-search-input>
    <button class="search-page-submit" type="submit">搜索</button>
  </form>

  <p class="search-status" role="status" aria-live="polite" data-search-status>输入关键词开始搜索。</p>
  <div class="search-results" data-search-results></div>
  <noscript><p class="search-empty">搜索功能需要启用 JavaScript。</p></noscript>
</section>

<script src="<%- url_for('/js/search.js') %>" defer></script>
