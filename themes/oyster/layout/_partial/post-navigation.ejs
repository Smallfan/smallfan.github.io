<% if (post.prev || post.next) { %>
  <nav class="navigation post-navigation" aria-label="文章导航">
    <div class="nav-links post-nav-links">
      <% if (post.prev) { %>
        <a class="nav-previous" href="<%- url_for(post.prev.path) %>" title="<%= post.prev.title %>">NEWER</a>
      <% } else { %>
        <span></span>
      <% } %>
      <% if (post.next) { %>
        <a class="nav-next" href="<%- url_for(post.next.path) %>" title="<%= post.next.title %>">OLDER</a>
      <% } %>
    </div>
  </nav>
<% } %>
