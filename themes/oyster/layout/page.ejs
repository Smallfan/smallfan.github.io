<% if (page.type === 'categories') { %>
  <article class="hentry taxonomy-page">
    <header class="entry-header">
      <h1 class="entry-title">Categories</h1>
    </header>
    <div class="entry-content taxonomy-list">
      <%- list_categories({ show_count: true, style: 'list' }) %>
    </div>
  </article>
<% } else if (page.type === 'tags') { %>
  <article class="hentry taxonomy-page">
    <header class="entry-header">
      <h1 class="entry-title">Tags</h1>
    </header>
    <div class="entry-content tag-cloud">
      <%- tagcloud({ min_font: 14, max_font: 14, amount: 999, orderby: 'name' }) %>
    </div>
  </article>
<% } else { %>
  <%- partial('_partial/article', { post: page, index: false }) %>
<% } %>
